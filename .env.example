# Copy to .env and change what you like.

# Exchanges to include: N = NYSE, A = NYSE American, P = NYSE Arca, Q = NASDAQ
STOCK_EXCHANGES=N
# 1 = include ETFs in the universe
INCLUDE_ETFS=0
# How far back daily data goes (Yahoo has most NYSE stocks back to 2000 or their IPO)
HISTORY_START=2000-01-01
# Lower this if training runs out of memory (8 GB Macs: try 800000)
MAX_TRAIN_ROWS=1500000
# Seconds between Yahoo batches; raise it if you get rate-limited
YAHOO_PAUSE=2.0
# Phone alerts with the top picks: install the ntfy app, subscribe to a hard-to-guess topic
NTFY_TOPIC=

# Free FRED API key → exact dates for CPI, jobs, GDP, PCE, PPI, retail sales releases
# Get one (1 minute): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# The SEC asks automated downloads to say who they are (insider trades)
SEC_USER_AGENT=Your Name your@email.com
# How many of the most-traded stocks get a daily option-chain snapshot (more = slower)
OPTIONS_TOP_N=300
